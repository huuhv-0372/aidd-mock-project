# Supabase project "saa-test" — copy to .env.test and fill in real values.
# Used by playwright.config.ts (process.loadEnvFile) and e2e/global-setup.ts.
# Never commit .env.test (already covered by .gitignore).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin API key for global-setup only (seed test users). Never exposed to the
# app runtime, never added to playwright.config.ts webServer.env.
SUPABASE_SERVICE_ROLE_KEY=
