# Server-only (never prefix with NEXT_PUBLIC_). Event start time that opens the gate.
# Format: ISO 8601 with an explicit UTC offset.
# Missing or invalid = gate stays open (no countdown) and a server error is logged.
# Production: set via wrangler vars (wrangler.jsonc), not a committed .env file.
EVENT_START_AT=2026-12-01T09:00:00+07:00

# Server-only (never prefix with NEXT_PUBLIC_). Awards ceremony time the homepage countdown targets.
# Format: ISO 8601 with an explicit UTC offset.
# Missing or invalid = countdown shows 00 and the "Coming soon" label is hidden; a server error is logged.
# Production: set via wrangler vars (wrangler.jsonc), not a committed .env file.
AWARDS_CEREMONY_AT=2026-12-26T18:30:00+07:00

# Supabase (public by design: protected by RLS, safe in the browser). Read at runtime, so the
# build needs neither. Verify exact key names on the Supabase dashboard (API keys page).
# Never put SUPABASE_SECRET_KEY / service-role key here with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
